#include <windows.h>

1 VERSIONINFO
 FILEVERSION 0,2,1,0
 PRODUCTVERSION 0,2,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "X4 Triple Screen contributors\0"
            VALUE "FileDescription", "X4-specific window hook\0"
            VALUE "FileVersion", "0.2.1-beta\0"
            VALUE "InternalName", "X4TripleScreenHook.dll\0"
            VALUE "LegalCopyright", "MIT License; includes BSD-2-Clause MinHook\0"
            VALUE "OriginalFilename", "X4TripleScreenHook.dll\0"
            VALUE "ProductName", "X4 Triple Screen\0"
            VALUE "ProductVersion", "0.2.1-beta\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
